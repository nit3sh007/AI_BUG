# Copy to .env (never commit it). Add your LLM key variables as before (GEMINI_API_KEY / GROQ_API_KEY / ...).

# Where the shop repo is checked out. Default is ../demo_app (next to this folder).
# DEMO_REPO=D:\2026\demo_app

# Git tag in the shop repo that Reset demo restores (default buggy-baseline).
# DEMO_BASELINE=buggy-baseline

# Hosted mode: leave empty for a purely local run.
REMOTE_APP_URL=
AUTOFIX_TOKEN=
# 1 = Approve also commits + pushes the fix to the shop's GitHub repo (Render then redeploys)
AUTO_PUSH=0
